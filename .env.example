# Leave LLM_API_KEY empty to use deterministic mock mode.
# The default model was selected through the benchmark in docs/evaluation/.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=low

# Decision Radar candidate records; independent of model context budget (40-300)
RADAR_MAX_DOCUMENTS=120
# Optional LLM_RADAR_SEARCH_* overrides inherit the existing LLM provider config.

# Same Flash model: low for direct answers, high only after server-validated Radar execution.
# RADAR_LLM_REASONING_EFFORT=high
# RADAR_LLM_MAX_TOKENS=6000
# RADAR_LLM_TIMEOUT_SECONDS=60
