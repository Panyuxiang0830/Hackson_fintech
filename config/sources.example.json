{
  "jira": {
    "enabled": false,
    "source": "jira",
    "corpus": "enterprise",
    "base_url": "https://YOUR-TENANT.atlassian.net",
    "email_env": "JIRA_EMAIL",
    "token_env": "JIRA_API_TOKEN",
    "jql": "project = YOUR_PROJECT ORDER BY key",
    "principal_map": {"ATLASSIAN_ACCOUNT_ID": "enterprise:alice"},
    "max_documents": 100,
    "acl_ttl_seconds": 300
  },
  "confluence": {
    "enabled": false,
    "source": "confluence",
    "corpus": "enterprise",
    "base_url": "https://YOUR-TENANT.atlassian.net",
    "email_env": "CONFLUENCE_EMAIL",
    "token_env": "CONFLUENCE_API_TOKEN",
    "space_ids": ["SPACE_NUMERIC_ID"],
    "principal_map": {"ATLASSIAN_ACCOUNT_ID": "enterprise:alice"},
    "max_documents": 100,
    "acl_ttl_seconds": 300
  },
  "slack": {
    "enabled": false,
    "source": "slack",
    "corpus": "enterprise",
    "base_url": "https://slack.com/api",
    "token_env": "SLACK_BOT_TOKEN",
    "channel_ids": ["CHANNEL_ID"],
    "principal_map": {"SLACK_USER_ID": "enterprise:alice"},
    "max_documents": 100,
    "acl_ttl_seconds": 300
  },
  "google_drive": {
    "enabled": false,
    "source": "google_drive",
    "corpus": "enterprise",
    "base_url": "https://www.googleapis.com/drive/v3",
    "token_env": "DRIVE_ACCESS_TOKEN",
    "folder_id": "FOLDER_ID",
    "principal_map": {"EXACT_USER_PERMISSION_ID_OR_EMAIL": "enterprise:alice"},
    "max_documents": 100,
    "acl_ttl_seconds": 300
  }
}
