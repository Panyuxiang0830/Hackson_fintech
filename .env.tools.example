# Private tool gateway. Copy into an ignored .env; never commit credentials.
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
# false: host answers using search/fetch; true additionally enables internal ask.
TOOL_INTERNAL_ANSWERS=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_PLANNER_ENABLED=false
LLM_REASONING_EFFORT=low
RADAR_LLM_REASONING_EFFORT=high
# MCP child process: this token binds one existing system user, not the whole company.
CL_TOOL_URL=http://127.0.0.1:17864
CL_TOOL_CORPUS=orgforge
CL_TOOL_TOKEN=
CL_MCP_ENABLE_ASK=false
CL_MCP_ENABLE_AUDIT=false
# Four adapters read only the environment variables named in sources configuration.
JIRA_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
SLACK_BOT_TOKEN=
DRIVE_ACCESS_TOKEN=
