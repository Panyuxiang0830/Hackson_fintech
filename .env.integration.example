# Copy configuration into an ignored .env, never commit real credentials.
APP_SECRET_KEY=
APP_PUBLIC_URL=http://127.0.0.1:7860
# Interactive browser login is deferred. Isolated loopback demo is separately opt-in.
BROWSER_LOGIN_ENABLED=false
DEMO_MODE=false
# For a demo set DEMO_MODE=true, APP_PUBLIC_URL to the loopback preview URL,
# and SECURITY_DIR to a separately demo-init initialized directory (never the production IAM).
# Optional legacy OIDC only; not needed for current setup.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
SECURITY_DIR=runtime/security
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=glm-5.3-flash
# One pre-retrieval planning call; UI switch can disable it for baseline comparison.
LLM_PLANNER_ENABLED=true
LLM_PLANNER_MODEL=glm-5.3-flash
# Optional independent endpoint/key; omitted fields reuse LLM_BASE_URL/API_KEY.
# LLM_PLANNER_BASE_URL=
# LLM_PLANNER_API_KEY=
# Audit generation defaults to LLM_MODEL (never gives the model direct SQL access).
# LLM_AUDIT_MODEL=glm-5.3-flash
# Review uses a separate call and prompt; blank reuses LLM_MODEL (current GLM).
# Same-model review is permitted, but is not independent verification.
LLM_REVIEW_ENABLED=true
LLM_REVIEW_MODEL=
# LLM_REVIEW_BASE_URL=
# LLM_REVIEW_API_KEY=
# Set false only for an explicitly unreviewed baseline, not a confirmed answer.
